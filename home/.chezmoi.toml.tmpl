{{- /* Asked once per machine at `chezmoi init`; answers live in ~/.config/chezmoi/chezmoi.toml, never in git. */ -}}
{{- $machine := promptChoiceOnce . "machine" "Which machine is this" (list "personal" "work") "personal" -}}

{{- /* CI has no 1Password: templates that read secrets are skipped there. */ -}}
{{- $secrets := eq (env "CI") "" -}}

{{- /* This repo is a member of the jarvis group repo and chezmoi's source directory is that clone,
       not ~/.local/share/chezmoi. The installer clones it there before `chezmoi init --source`. */}}
sourceDir = {{ joinPath .chezmoi.homeDir "Workspace/nass600/jarvis/dotfiles" | quote }}

[data]
    name = "Ignacio Velazquez"
    email = "ivelazquez85@gmail.com"
    github_user = "nass600"
    machine = {{ $machine | quote }}
    secrets = {{ $secrets }}

[onepassword]
    command = "op"

# Environment for every run script. Homebrew is tuned for an unattended install:
#   - one explicit `brew update` in the formulae step instead of a hidden one per command
#   - no cleanup pass after each install (run `brew cleanup` by hand)
#   - curl gives up on a host that does not answer in 10s (see ~/.config/homebrew/curlrc) and does
#     not retry by itself (Homebrew's download queue already retries once), so a blocked download
#     host costs about 30 seconds instead of ten minutes per run
[scriptEnv]
    HOMEBREW_NO_AUTO_UPDATE = "1"
    HOMEBREW_NO_INSTALL_CLEANUP = "1"
    HOMEBREW_NO_ENV_HINTS = "1"
    HOMEBREW_CURL_RETRIES = "0"
    HOMEBREW_CURLRC = {{ joinPath .chezmoi.homeDir ".config/homebrew/curlrc" | quote }}
