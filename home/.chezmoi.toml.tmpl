{{- /* One question, asked once per Mac at `chezmoi init`: which 1Password vault this Mac belongs to,
       picked from the vaults 1Password lists so the name cannot be mistyped (type its first letters).
       The answer lives in ~/.config/chezmoi/chezmoi.toml, never in git. The vault's "dotfiles" note
       says who the Mac is (profile, git email, app bundle, backup, prompt colour), so the repo never
       names a vault or a company. See README, "Machines and vaults". */ -}}

{{- /* CI has no 1Password: templates that read secrets are skipped there and the vault and identity
       fields come from the environment (DOTFILES_VAULT, DOTFILES_PROFILE, DOTFILES_EMAIL, DOTFILES_APPS,
       DOTFILES_CLAUDE_BACKUP, DOTFILES_PROMPT_COLOR) so both app bundles can be rendered. */ -}}
{{- $secrets := eq (env "CI") "" -}}
{{- $vault := "" -}}
{{- $profile := "" -}}{{- $email := "" -}}{{- $apps := "" -}}{{- $backup := "" -}}{{- $color := "" -}}
{{- if $secrets -}}
{{- /* The choices come from `op vault list`, offered in lowercase so `p` picks Private (the prompt matches
       typed letters exactly). A kept answer is reused; `chezmoi init --prompt` asks again. 1Password must
       be unlocked with the CLI integration on, as the note reads below need anyway; the installer makes
       sure of that before init. */ -}}
{{-   if not (lookPath "op") }}{{ fail "the 1Password CLI (op) is not installed" }}{{ end -}}
{{-   $byLower := dict -}}
{{-   range (output "op" "vault" "list" "--format" "json" | fromJson) }}{{ $_ := set $byLower (lower .name) .name }}{{ end -}}
{{-   $pick := promptChoiceOnce . "vault" "Which 1Password vault is this Mac" (keys $byLower | sortAlpha) | lower -}}
{{-   $vault = index $byLower $pick | default "" -}}
{{-   if not $vault }}{{ fail (printf "vault %q is not in 1Password any more: run chezmoi init --prompt" $pick) }}{{ end -}}
{{-   $profile = onepasswordRead (printf "op://%s/dotfiles/profile" $vault) | trim -}}
{{-   $email = onepasswordRead (printf "op://%s/dotfiles/email" $vault) | trim -}}
{{-   $apps = onepasswordRead (printf "op://%s/dotfiles/apps" $vault) | trim -}}
{{-   $backup = onepasswordRead (printf "op://%s/dotfiles/claude_backup" $vault) | trim -}}
{{-   $color = onepasswordRead (printf "op://%s/dotfiles/prompt_color" $vault) | trim -}}
{{- else -}}
{{-   $vault = env "DOTFILES_VAULT" | default "Private" -}}
{{-   $profile = env "DOTFILES_PROFILE" | default "personal" -}}
{{-   $email = env "DOTFILES_EMAIL" | default "ci@example.com" -}}
{{-   $apps = env "DOTFILES_APPS" | default "personal" -}}
{{-   $backup = env "DOTFILES_CLAUDE_BACKUP" | default "true" -}}
{{-   $color = env "DOTFILES_PROMPT_COLOR" | default "34" -}}
{{- end -}}

{{- /* This repo is a member of the jarvis group repo and chezmoi's source directory is that clone,
       not ~/.local/share/chezmoi. The installer clones it there before `chezmoi init --source`. */}}
sourceDir = {{ joinPath .chezmoi.homeDir "Workspace/nass600/jarvis/dotfiles" | quote }}

[data]
    name = "Ignacio Velazquez"
    github_user = "nass600"
    # The answer, kept so init does not ask again.
    vault = {{ $vault | quote }}
    # From that vault's dotfiles note.
    profile = {{ $profile | quote }}
    email = {{ $email | quote }}
    apps = {{ $apps | quote }}
    claude_backup = {{ eq (lower $backup) "true" }}
    prompt_color = {{ $color | atoi }}
    secrets = {{ $secrets }}

# The CLI is unlocked by the 1Password app (Settings > Developer > CLI integration), so chezmoi
# must not run its own `op signin`, which has no app prompt and times out outside a terminal.
[onepassword]
    command = "op"
    prompt = false

# Environment for every run script. Homebrew is tuned for an unattended install:
#   - one explicit `brew update` in the formulae step instead of a hidden one per command
#   - no cleanup pass after each install (run `brew cleanup` by hand)
#   - curl gives up on a host that does not answer in 10s (see ~/.config/homebrew/curlrc) and does
#     not retry by itself (Homebrew's download queue already retries once), so a blocked download
#     host costs about 30 seconds instead of ten minutes per run
[scriptEnv]
    HOMEBREW_NO_AUTO_UPDATE = "1"
    HOMEBREW_NO_INSTALL_CLEANUP = "1"
    HOMEBREW_NO_ENV_HINTS = "1"
    HOMEBREW_CURL_RETRIES = "0"
    HOMEBREW_CURLRC = {{ joinPath .chezmoi.homeDir ".config/homebrew/curlrc" | quote }}
