# Font
font-family = MesloLGS Nerd Font Mono
font-size = 12

# Theme
theme = dark:Monokai Pro,light:Monokai Pro Light

# Window
window-padding-x = 8
window-padding-y = 8

# Shell
shell-integration = zsh

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000
