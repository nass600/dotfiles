# Docker Desktop writes this block when it finds it missing; its marker lines are kept as written so
# it recognises the block and leaves the file alone. $HOME stands in for the path it writes.
# The following lines were added by Docker Desktop to add commands to your PATH.
export PATH="$PATH:$HOME/.docker/bin"
# End of Docker Desktop section.

# Homebrew (Apple Silicon)
if [ -d "/opt/homebrew/bin" ]; then
    export PATH="/opt/homebrew/bin:$PATH"
    export PATH="/opt/homebrew/sbin:$PATH"
fi

# mise shims, so apps started outside a terminal (editors, launchd) find node and python too.
# Interactive shells get the full `mise activate` from .zshrc.
export PATH="$HOME/.local/share/mise/shims:$PATH"
