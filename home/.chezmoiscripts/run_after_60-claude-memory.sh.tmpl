{{- if .claude_backup -}}
#!/bin/bash
# Restores Claude Code memory from the newest iCloud backup when ~/.claude/projects is empty, which
# is only the case on a fresh Mac. Afterwards the launch agent from step 50 keeps the backup current.

{{ template "log.sh" "60-claude-memory" }}
{{ template "step.sh" }}

PROJECTS="$HOME/.claude/projects"

if [ -d "$PROJECTS" ] && [ -n "$(ls -A "$PROJECTS" 2>/dev/null)" ]; then
    echo "Claude Code memory: in place."
    exit 0
fi

echo "Claude Code memory: restoring from iCloud Drive."
step_total 1
run_item "claude memory" "wait for iCloud Drive to finish downloading Config/Claude, then chezmoi apply or claude-backup --restore" "$HOME/.local/bin/claude-backup" --restore
step_done "Claude Code memory"
exit 0
{{- end -}}
