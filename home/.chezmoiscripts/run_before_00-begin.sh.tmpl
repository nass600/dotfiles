#!/bin/bash
# Runs first on every `chezmoi apply`: starts empty failure and manual-note lists. Each step appends
# what it could not do or what only a human can do, and 99-summary prints both at the end.
LOG_DIR="$HOME/Library/Logs/dotfiles"
mkdir -p "$LOG_DIR"
: >"$LOG_DIR/failures.tsv"
: >"$LOG_DIR/manual.tsv"
