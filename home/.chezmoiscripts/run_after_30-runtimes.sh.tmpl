#!/bin/bash
# Runtimes and global tools, declared in .chezmoidata/runtimes.toml. mise owns node, python and the
# npm and PyPI tools through ~/.config/mise/config.toml (rendered from the same file); uv installs
# the private PyPI tools over the 1Password ssh agent, because mise cannot list a private repo's
# versions. Runs on every `chezmoi apply`: `mise ls --missing` and `uv tool list` say what is
# missing (a few seconds), and only that is installed, one line per item.
{{- $m := index .runtimes .machine }}
{{- $git := concat .runtimes.python_tools_git $m.python_tools_git }}

{{ template "log.sh" "30-runtimes" }}
{{ template "step.sh" }}

if ! command -v brew >/dev/null 2>&1 && [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export MISE_YES=1
FORMULA_HINT="comes from the Homebrew formulae step (20): fix that first"

# --- installers (output goes to the log) ---
missing_tool()  { echo "Error: $1 is not installed"; return 1; }
mise_install()  { mise install "$1"; }
# --force replaces executables left by an older pip/poetry/pipx install of the same tool.
uv_install()    { uv tool install --force "$1"; }
install_skill() { graphify install --platform claude; }

# --- checks: build the list of what needs doing ---
names=()
hints=()
cmds=()
pending() { names+=("$1"); hints+=("$2"); cmds+=("$3"); }

if ! command -v mise >/dev/null 2>&1; then
    pending "mise tools (node, python, npm and PyPI tools)" "$FORMULA_HINT" "missing_tool mise"
else
    # Runtimes first (no ":" in the name), then the npm/pypi tools that run on them.
    while IFS= read -r tool; do
        [ -n "$tool" ] && pending "$tool" "mise install $tool" "mise_install $tool"
    done < <(mise ls --missing -J 2>/dev/null | /usr/bin/python3 -c '
import json, sys
tools = list(json.load(sys.stdin))
print("\n".join([t for t in tools if ":" not in t] + [t for t in tools if ":" in t]))' 2>/dev/null)
fi

{{- range $git }}
if ! command -v uv >/dev/null 2>&1; then
    pending "uv {{ .name }}" "$FORMULA_HINT" "missing_tool uv"
elif ! uv tool list 2>/dev/null | grep -q '^{{ .name }} '; then
    pending "uv {{ .name }} (private repo)" "needs the 1Password ssh agent unlocked: uv tool install {{ .url }}" "uv_install {{ .url }}"
fi
{{- end }}

if command -v graphify >/dev/null 2>&1 && [ ! -f "$HOME/.claude/skills/graphify/SKILL.md" ]; then
    pending "graphify skill for Claude Code" "graphify install --platform claude" "install_skill"
fi

# --- do it ---
if [ ${#names[@]} -eq 0 ]; then
    echo "Runtimes and tools: all in place."
    exit 0
fi
echo "Runtimes and tools: ${#names[@]} to install."
step_total ${#names[@]}
for i in "${!names[@]}"; do
    # shellcheck disable=SC2086 # the command and its argument are split on purpose
    run_item "${names[$i]}" "${hints[$i]}" ${cmds[$i]}
done
step_done "Runtimes and tools"
exit 0
