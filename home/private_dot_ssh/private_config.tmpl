# Hosts from the dotfiles note in the {{ .vault }} vault.
{{ onepasswordRead (printf "op://%s/dotfiles/ssh_config" .vault) | trim }}

{{ end -}}
Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
